    local function GetClosestEnemy()
        local bestTarget, bestMagnitude = nil, Settings.FOVRadius
        for _,player in ipairs(Players:GetPlayers()) do
            if IsEnemy(player) and player.Character and player.Character:FindFirstChild(Settings.AimPart) and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health>0 then
                local part = player.Character[Settings.AimPart]
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                if not part or not root then continue end
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X,screenPos.Y)-Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)).Magnitude
                    if dist<bestMagnitude then
                        if Settings.WallCheck then
                            local rp=RaycastParams.new()
                            rp.FilterType=Enum.RaycastFilterType.Blacklist
                            rp.FilterDescendantsInstances={LocalPlayer.Character}
                            local result=workspace:Raycast(Camera.CFrame.Position,(part.Position-Camera.CFrame.Position).Unit*((part.Position-Camera.CFrame.Position).Magnitude),rp)
                            if result and not result.Instance:IsDescendantOf(player.Character) then continue end
                        end
                        bestTarget, bestMagnitude = part, dist
                    end
                end
            end
        end
        return bestTarget
    end

    local FOVCircle = Drawing.new("Circle")
    FOVCircle.Thickness = 2.2
    FOVCircle.NumSides = 99
    FOVCircle.Filled = false
    FOVCircle.Transparency = 0.95

    RunService.RenderStepped:Connect(function()
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        FOVCircle.Radius = Settings.FOVRadius
        FOVCircle.Color = Settings.FOVColor
        FOVCircle.Visible = Settings.FOVVisible and Settings.AimbotEnabled
        local anyDragging = false
        for _,state in pairs(SliderDragging) do if state then anyDragging=true;break end end
        if not anyDragging and Settings.AimbotEnabled then
            local target = GetClosestEnemy()
            if target then
                local camCF = Camera.CFrame
                local newCF = CFrame.new(camCF.Position, target.Position)
                Camera.CFrame = camCF:Lerp(newCF, Settings.Smoothness)
            end
        end
    end)

    local function isInCrosshair(plr)
        if not plr.Character or not plr.Character:FindFirstChild("Head") then return false end
        local head = plr.Character.Head
        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then return false end
        local center = Vector2.new(Camera.ViewportSize.X / 2,Camera.ViewportSize.Y/2)
        local dist = (Vector2.new(screenPos.X,screenPos.Y)-center).Magnitude
        if dist>Settings.TriggerbotRadius then return false end
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Blacklist
        rp.FilterDescendantsInstances={LocalPlayer.Character}
        local result = workspace:Raycast(Camera.CFrame.Position,(head.Position-Camera.CFrame.Position).Unit*(head.Position-Camera.CFrame.Position).Magnitude,rp)
        if result and not result.Instance:IsDescendantOf(plr.Character) then return false end
        return true
    end
    RunService.Heartbeat:Connect(function()
        if Settings.TriggerbotEnabled then
            for _,plr in ipairs(Players:GetPlayers()) do
                if IsEnemy(plr) and isInCrosshair(plr) then
                    mouse1press() wait(0.011) mouse1release() break
                end
            end
        end
    end)

    pcall(function() game.StarterGui:SetCore("SendNotification", {
        Title = "🎄 Nulux Hub 🎄 Beta",Text = "Enemy-only ESP, Aimbot, Camlock, Triggerbot, Merry Christmas "..tostring(username).."!",Duration = 13
    }) end)
end
