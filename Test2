    local function IsEnemy(player)
        if not player or player==LocalPlayer then return false end
        if not Settings.TeamCheck or not LocalPlayer.Team or not player.Team then return true end
        return player.Team~=LocalPlayer.Team
    end
    local ESPObjects = {}
    local function CreateESP(player)
        if player==LocalPlayer or ESPObjects[player] then return end
        local box=Drawing.new("Square");box.Thickness=2;box.Filled=false;box.Color=Color3.fromRGB(255,0,0);box.Transparency=1
        local name=Drawing.new("Text");name.Size=14;name.Color=Color3.new(1,1,1);name.Outline=true;name.Center=true
        local health=Drawing.new("Line");health.Thickness=3
        local tracer=Drawing.new("Line");tracer.Thickness=1.5;tracer.Color=Color3.fromRGB(255,0,0)
        local distance=Drawing.new("Text");distance.Size=12;distance.Color=Color3.new(1,1,1);distance.Outline=true;distance.Center=true
        ESPObjects[player]={box=box,name=name,health=health,tracer=tracer,distance=distance}
    end
    local function UpdateESPs()
        for player,drawings in pairs(ESPObjects) do
            local espVisible=false
            if IsEnemy(player)
            and player.Character and player.Character:FindFirstChild("Head")
            and player.Character:FindFirstChild("HumanoidRootPart")
            and player.Character:FindFirstChild("Humanoid")
            and player.Character.Humanoid.Health>0 then
                local headPos = Camera:WorldToViewportPoint(player.Character.Head.Position+Vector3.new(0,3,0))
                local rootPos = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                local legPos = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position-Vector3.new(0,3,0))
                if headPos.Z>0 and rootPos.Z>0 then
                    local height = math.abs(headPos.Y-legPos.Y)
                    local width = height/2
                    drawings.box.Size = Vector2.new(width,height)
                    drawings.box.Position = Vector2.new(rootPos.X-width/2,headPos.Y)
                    drawings.name.Text = player.Name
                    drawings.name.Position = Vector2.new(rootPos.X,headPos.Y-20)
                    local healthRatio=player.Character.Humanoid.Health/player.Character.Humanoid.MaxHealth
                    drawings.health.From = Vector2.new(drawings.box.Position.X-5,drawings.box.Position.Y+height)
                    drawings.health.To = Vector2.new(drawings.health.From.X,drawings.health.From.Y-height*healthRatio)
                    drawings.health.Color = Color3.fromHSV(healthRatio/3,1,1)
                    drawings.tracer.From = Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
                    drawings.tracer.To = Vector2.new(rootPos.X,rootPos.Y)
                    local dist = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position-player.Character.HumanoidRootPart.Position).Magnitude or 0)
                    drawings.distance.Text = math.floor(dist).." studs"
                    drawings.distance.Position = Vector2.new(rootPos.X,rootPos.Y+height/2)
                    espVisible = Settings.ESPEnabled
                end
            end
            for _,obj in pairs(drawings) do obj.Visible = espVisible end
        end
    end
